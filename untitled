from telegram import Update, InlineKeyboardButton, InlineKeyboardMarkup
from telegram.ext import (
    Application,
    CommandHandler,
    CallbackQueryHandler,
    MessageHandler,
    ContextTypes,
    filters,
)

BOT_TOKEN = "8744638182:AAGT19BMJhrVzfgw3_sPPHfHfLv24WjykL0"

user_mode = {}

async def start(update: Update, context: ContextTypes.DEFAULT_TYPE):
    keyboard = [
        [InlineKeyboardButton("🎥 ទាញយកវីដេអូ", callback_data="video")],
        [InlineKeyboardButton("🖼️ ទាញយករូបភាព", callback_data="image")],
        [InlineKeyboardButton("🎵 ទាញយកជា MP3", callback_data="mp3")]
    ]

    await update.message.reply_text(
        "សូមជ្រើសរើសប្រភេទដែលចង់ទាញយក៖",
        reply_markup=InlineKeyboardMarkup(keyboard)
    )

async def button_click(update: Update, context: ContextTypes.DEFAULT_TYPE):
    query = update.callback_query
    await query.answer()

    user_mode[query.from_user.id] = query.data

    await query.message.reply_text(
        "សូមផ្ញើ Link មក។"
    )

async def handle_link(update: Update, context: ContextTypes.DEFAULT_TYPE):
    user_id = update.effective_user.id
    url = update.message.text

    mode = user_mode.get(user_id)

    if not mode:
        await update.message.reply_text(
            "សូមចុច /start ជាមុនសិន"
        )
        return

    if mode == "video":
        await update.message.reply_text(
            f"🎥 បានទទួល Link សម្រាប់ Video:\n{url}"
        )

    elif mode == "image":
        await update.message.reply_text(
            f"🖼️ បានទទួល Link សម្រាប់ Image:\n{url}"
        )

    elif mode == "mp3":
        await update.message.reply_text(
            f"🎵 បានទទួល Link សម្រាប់ MP3:\n{url}"
        )

def main():
    app = Application.builder().token(BOT_TOKEN).build()

    app.add_handler(CommandHandler("start", start))
    app.add_handler(CallbackQueryHandler(button_click))
    app.add_handler(MessageHandler(filters.TEXT & ~filters.COMMAND, handle_link))

    print("Bot running...")
    app.run_polling()

if __name__ == "__main__":
    main()